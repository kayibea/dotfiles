#!/usr/bin/env bash

LOCAL_OPT="$HOME/.local/opt"

# XDG base dirs
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"

# GNU PG
export GPG_TTY=$(tty)

# GNU Pass
export PASSWORD_STORE_GENERATED_LENGTH=32
export PASSWORD_STORE_ENABLE_EXTENSIONS=true
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"
export PASSWORD_STORE_EXTENSIONS_DIR="$PASSWORD_STORE_DIR/.extensions"

# Editor / UI
export EDITOR="$(command -v hx 2>/dev/null | xargs basename 2>/dev/null || printf "%s" vi)"
export GTK_THEME="Adwaita:dark"
export HELIX_RUNTIME="$LOCAL_OPT/helix/runtime"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc-2.0"

# Rust
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"

# Parallel
export PARALLEL_HOME="$XDG_STATE_HOME/parallel"

# Node / npm
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node_repl_history"

# Android Studio
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_USER_HOME="$XDG_DATA_HOME/android"
export ANDROID_EMULATOR_HOME="$ANDROID_USER_HOME"
export ANDROID_AVD_HOME="$ANDROID_EMULATOR_HOME/avd"
export ANDROID_DEVICE_TMPDIR="/data/local/tmp"

# Termux
TERMUX_FILES_ROOT="/data/data/com.termux/files"
export TERMUX_HOME="$TERMUX_FILES_ROOT/home"
export TERMUX_PREFIX="$TERMUX_FILES_ROOT/usr"
export TERMUX_TMPDIR="$TERMUX_PREFIX/tmp"

# Base PATH
export PATH="/usr/sbin:/sbin:$PATH"

# Local optional tools
export PATH="$LOCAL_OPT/scrcpy:$PATH"
export PATH="$LOCAL_OPT/jadx/bin:$PATH"
export PATH="$LOCAL_OPT/real-esrgan:$PATH"
export PATH="$LOCAL_OPT/lua-language-server/bin:$PATH"

# Android tools
export PATH="$ANDROID_HOME/emulator:$PATH"
export PATH="$ANDROID_HOME/platform-tools:$PATH"
export PATH="$ANDROID_HOME/build-tools/36.1.0:$PATH"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"

# Golang
export GOROOT="$LOCAL_OPT/go"
export GOPATH="$XDG_DATA_HOME/go"
export GOBIN="$GOPATH/bin"
export GOCACHE="$XDG_CACHE_HOME/go"
export GOMODCACHE="$GOPATH/pkg/mod"
export GOENV="$XDG_CONFIG_HOME/go/env"
export PATH="$GOROOT/bin:$GOBIN:$PATH"

# Lua
export LLS_ADDONS="$LOCAL_OPT/LLS-Addons/addons"
export LUA_PATH="$XDG_DATA_HOME/luarocks/share/lua/5.5/?.lua;;"
export LUA_CPATH="$XDG_DATA_HOME/luarocks/lib/lua/5.5/?.so;;"
export LUAROCKS_CONFIG="$XDG_CONFIG_HOME/luarocks/config.lua"

# Java / Gradle
export SDKMAN_DIR="$XDG_DATA_HOME/sdkman"
export _JAVA_AWT_WM_NONREPARENTING=1
export _JAVA_OPTIONS="-Djava.util.prefs.userRoot=$XDG_CONFIG_HOME/java"
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"

# Libvirt
export LIBVIRT_DEFAULT_URI="qemu:///system"

# SSH agent
export SSH_AGENT_ENV="$HOME/.ssh/agent.env"
[[ -f "$SSH_AGENT_ENV" ]] && source "$SSH_AGENT_ENV" >/dev/null

# Tools
eval "$(batman --export-env)"
FZF_ALT_C_COMMAND= FZF_CTRL_T_COMMAND= eval "$(fzf --bash)"
