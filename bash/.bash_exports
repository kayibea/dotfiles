#!/usr/bin/env bash

# export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:/usr/sbin:/sbin"

OPT="$HOME/.local/opt"
export PATH="$PATH:$OPT/go/bin"
export PATH="$PATH:$OPT/jadx/bin"
export PATH="$PATH:$OPT/lua-language-server/bin"

SDK_ROOT="$HOME/AndroidX/Sdk"
# export ANDROID_SDK_ROOT="$HOME/AndroidX/Sdk"
export PATH="$PATH:$SDK_ROOT/platform-tools"
export PATH="$PATH:$SDK_ROOT/cmdline-tools/latest/bin"
export PATH="$PATH:$SDK_ROOT/build-tools/36.1.0"
export PATH="$PATH:$SDK_ROOT/emulator"

TERMUX_FILES_ROOT="/data/data/com.termux/files"
export TERMUX_HOME="$TERMUX_FILES_ROOT/home"
export TERMUX_PREFIX="$TERMUX_FILES_ROOT/usr"
export TERMUX_TMPDIR="$TERMUX_PREFIX/tmp"
export ANDROID_TMPDIR="/data/local/tmp"

export EDITOR="hx"
export GTK_THEME="Adwaita:dark"

export GOROOT="$HOME/.local/opt/go"
export PATH="$PATH:$GOROOT/bin"
export PATH="$PATH:$(go env GOPATH)/bin"

export LLSA="$HOME/code/lua/LLS-Addons/addons"
export LUA_PATH="$HOME/.local/share/lua/5.4/?.lua;$HOME/.luarocks/share/lua/5.4/?.lua;;"
export LUA_CPATH="$HOME/.local/lib/lua/5.4/?.so;$HOME/.luarocks/lib/lua/5.4/?.so;;"

export _JAVA_AWT_WM_NONREPARENTING=1

export LIBVIRT_DEFAULT_URI="qemu:///system"

export PASSWORD_STORE_GENERATED_LENGTH=32

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
