#!/usr/bin/env bash

OPT="$HOME/.local/opt"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"

export EDITOR="hx"
export GTK_THEME="Adwaita:dark"
export HELIX_RUNTIME="$OPT/helix/runtime"

export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_USER_HOME="$XDG_CONFIG_HOME/.android"
export ANDROID_EMULATOR_HOME="$ANDROID_USER_HOME"
export ANDROID_AVD_HOME="$ANDROID_EMULATOR_HOME/avd"

PATH="$PATH:/usr/sbin:/sbin"
PATH="$PATH:$OPT/scrcpy"
PATH="$PATH:$OPT/go/bin"
PATH="$PATH:$OPT/jadx/bin"
PATH="$PATH:$OPT/real-esrgan"
PATH="$PATH:$OPT/lua-language-server/bin"
PATH="$PATH:$ANDROID_HOME/emulator"
PATH="$PATH:$ANDROID_HOME/platform-tools"
PATH="$PATH:$ANDROID_HOME/build-tools/36.1.0"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin"
# export PATH="$PATH:$HOME/.local/bin"

export GOROOT="$OPT/go"
PATH="$PATH:$GOROOT/bin"
export PATH="$PATH:$(go env GOPATH)/bin"

# FIXME: Wrong path for termux
TERMUX_FILES_ROOT="/data/data/com.termux/files"
export TERMUX_HOME="$TERMUX_FILES_ROOT/home"
export TERMUX_PREFIX="$TERMUX_FILES_ROOT/usr"
export TERMUX_TMPDIR="$TERMUX_PREFIX/tmp"
export ANDROID_DEVICE_TMPDIR="/data/local/tmp"

export LLS_ADDONS="$OPT/LLS-Addons/addons"
# export LUA_PATH="$HOME/.local/share/lua/5.5/?.lua;$HOME/.luarocks/share/lua/5.5/?.lua;;"
# export LUA_CPATH="$HOME/.local/lib/lua/5.5/?.so;$HOME/.luarocks/lib/lua/5.5/?.so;;"

export _JAVA_AWT_WM_NONREPARENTING=1

export LIBVIRT_DEFAULT_URI="qemu:///system"

export PASSWORD_STORE_GENERATED_LENGTH=32
export PASSWORD_STORE_DIR="$XDG_CONFIG_HOME/password-store"

export SSH_AGENT_ENV="$HOME/.ssh/agent.env"
[[ -f $SSH_AGENT_ENV ]] && . $SSH_AGENT_ENV >/dev/null

eval "$(batman --export-env)"
FZF_ALT_C_COMMAND= FZF_CTRL_T_COMMAND= eval "$(fzf --bash)"
