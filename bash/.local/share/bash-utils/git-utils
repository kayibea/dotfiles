#!/usr/bin/env bash

_git_has_changes() {
  local staged=$1
  if $staged; then
    git diff --cached --quiet || return 0
  else
    git diff --quiet || return 0
  fi
  return 1
}

gd() {
  local staged=false
  [[ "$1" == "--cached" || "$1" == "-c" ]] && staged=true

  if [[ ! -d "$PWD/.git" ]]; then
    echo "must run from repo root" >&2
    return 1
  fi

  _git_has_changes $staged || {
    git status
    return 0
  }

  local diff_flags=()
  $staged && diff_flags+=(--cached)

  local files
  files=$(git diff --name-only "${diff_flags[@]}")

  local tmpfiles=()
  local f tmp
  for f in $files; do
    tmp=$(mktemp -t git-XXXXXX.diff)
    git diff "${diff_flags[@]}" -- "$f" >"$tmp"
    tmpfiles+=("$tmp")
  done

  chmod 400 -- "${tmpfiles[@]}"
  "$EDITOR" -- "${tmpfiles[@]}"
  rm -f -- "${tmpfiles[@]}"
}
