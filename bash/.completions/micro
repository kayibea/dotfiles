#!/usr/bin/env bash

# bash completion for micro editor

_micro_bool_values() {
  COMPREPLY=($(compgen -W "true false" -- "$1"))
}

_micro_plugin_names() {
  local cur="$1"
  local candidates

  # Try to get installed plugins via micro itself (fast if micro is available)
  if command -v micro >/dev/null 2>&1; then
    candidates=$(micro -plugin list 2>/dev/null | awk '{print $1}' || true)
  fi

  # fallback: try common micro plugin locations
  if [ -z "$candidates" ]; then
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/micro"
    candidates=$(ls -1 "${cfg}/plug" 2>/dev/null || true)
    if [ -z "$candidates" ]; then
      candidates=$(ls -1 "${cfg}/plugin" 2>/dev/null || true)
    fi
  fi

  COMPREPLY=($(compgen -W "$candidates" -- "$cur"))
}

_micro_complete() {
  local cur prev words cword
  _init_completion || return 0 # uses bash-completion helper if present

  # Fallback init if _init_completion not available:
  if [ -z "$cur" ]; then
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD - 1]}"
    words=("${COMP_WORDS[@]}")
    cword=$COMP_CWORD
  fi

  # option lists
  local general_opts="
-clean -config-dir -options -debug -profile -version -plugin
"
  # Many options take boolean values
  local bool_opts="
-autoindent -autosave -autosu -backup -basename -clipboard -cursorline -diffgutter -divreverse -eofnewline
-fakecursor -fastdirty -filetype -helpsplit -hlsearch -hltaberrors -hltrailingws -ignorecase -incsearch
-infobar -keepautoindent -keymenu -matchbrace -matchbraceleft -mkparents -mouse -multiopen -paste
-permbackup -readonly -relativeruler -reload -rmtrailingws -ruler -savecursor -savehistory -saveundo
-scrollbar -showchars -smartpaste -softwrap -splitbottom -splitright -statusline -syntax -tabhighlight
-tabmovement -tabreverse -truecolor -useprimary -wordwrap -xterm
"

  # options that expect directory or file paths
  local dir_opts="-config-dir -backupdir"
  local file_opts="" # none special besides file args

  # some options we can provide a small set of suggested values for
  declare -A enum_opts
  enum_opts["-fileformat"]="unix dos"
  enum_opts["-encoding"]="utf-8 latin1 utf-16"
  enum_opts["-colorscheme"]="default solarized darcula"
  enum_opts["-multiopen"]="tab split"
  enum_opts["-parsecursor"]="true false"
  enum_opts["-sucmd"]="sudo doas"

  # plugin subcommands
  local plugin_subs="install remove update search list available"

  # If previous word is -plugin or the current word is after -plugin
  if [[ "${prev}" == "-plugin" ]]; then
    COMPREPLY=($(compgen -W "$plugin_subs" -- "$cur"))
    return 0
  fi

  # When the subcommand is plugin <sub>, and we need plugin names:
  if [[ "${COMP_WORDS[1]}" == "-plugin" ]]; then
    # plugin subcommand is the second word
    local sub="${COMP_WORDS[2]:-}"
    case "$sub" in
      install | remove | update | search)
        # If user is completing the plugin name (third+)
        _micro_plugin_names "$cur"
        return 0
        ;;
      list | available)
        # these take no further args; nothing to complete
        return 0
        ;;
    esac
  fi

  # If user is typing an option (starts with -), suggest options
  if [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "$general_opts $bool_opts $dir_opts" -- "$cur"))
    return 0
  fi

  # If previous token is an option that expects a value:
  if [[ " $bool_opts " == *" $prev "* ]]; then
    # boolean
    _micro_bool_values "$cur"
    return 0
  fi

  if [[ " $dir_opts " == *" $prev "* ]]; then
    # directory completion
    _filedir -d
    return 0
  fi

  # enum options: check if prev is one and suggest limited values
  for opt in "${!enum_opts[@]}"; do
    if [[ "$prev" == "$opt" ]]; then
      COMPREPLY=($(compgen -W "${enum_opts[$opt]}" -- "$cur"))
      return 0
    fi
  done

  # If current token starts with + (cursor position or regex), no special completion
  if [[ "$cur" == +* ]]; then
    COMPREPLY=()
    return 0
  fi

  # Default: complete file names for positional file arguments
  _filedir
  return 0
}

# Bind the completion function: use both `micro` and `micro.exe` if present (WSL/Windows)
complete -F _micro_complete micro micro.exe
