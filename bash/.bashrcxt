#!/usr/bin/env bash

shopt -s nullglob

[ -f ~/.bash_exports ] && . ~/.bash_exports
[ -f ~/.bash_aliases ] && . ~/.bash_aliases

for file in "$HOME"/.functions/*; do
  [ -f "$file" ] && . "$file"
done

for file in "$HOME"/.completions/*; do
  [ -f "$file" ] && . "$file"
done

prompt_color='\[\033[;32m\]'
export PS1=$prompt_color'\[\033[0;1m\] '$prompt_color'${VIRTUAL_ENV:+(\[\033[0;1m\]$(basename $VIRTUAL_ENV)'$prompt_color')}\[\033[0m\] '

VIRTUAL_ENV_DISABLE_PROMPT=1
