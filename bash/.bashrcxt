#!/usr/bin/env bash

shopt -s nullglob

[ -f ~/.bash_exports ] && . ~/.bash_exports
[ -f ~/.bash_aliases ] && . ~/.bash_aliases
[ -f ~/.bash_logout ] && . ~/.bash_logout

source_dirs=("$XDG_DATA_HOME/bash-completions" "$XDG_DATA_HOME/bash-helpers")
for dir in "${source_dirs[@]}"; do
  [[ -d "$dir" ]] || continue
  for f in "$dir"/*; do
    [ -f "$f" ] && . "$f"
  done
done
unset source_dirs

_ps_green='\[\033[0;32m\]'
_ps_bold='\[\033[0;1m\]'
_ps_reset='\[\033[0m\]'

_ps_sep='─'
_ps_icon=''

_ps_venv='${VIRTUAL_ENV:+('"$_ps_bold"'$(basename "$VIRTUAL_ENV")'"$_ps_green"')}'

export PS1="$_ps_green$_ps_bold$_ps_sep$_ps_green$_ps_venv$_ps_icon$_ps_reset "

VIRTUAL_ENV_DISABLE_PROMPT=1
