#!/usr/bin/env bash

shopt -s nullglob

[ -f ~/.bash_exports ] && . ~/.bash_exports
[ -f ~/.bash_aliases ] && . ~/.bash_aliases

for file in "$HOME"/.{functions,completions}/*; do
  [ -f "$file" ] && . "$file"
done

_ps_green='\[\033[0;32m\]'
_ps_bold='\[\033[0;1m\]'
_ps_reset='\[\033[0m\]'

_ps_sep='─'
_ps_icon=''

_ps_venv='${VIRTUAL_ENV:+('"$_ps_bold"'$(basename "$VIRTUAL_ENV")'"$_ps_green"')}'

export PS1="$_ps_green$_ps_bold$_ps_sep$_ps_green$_ps_venv$_ps_icon$_ps_reset "

VIRTUAL_ENV_DISABLE_PROMPT=1
