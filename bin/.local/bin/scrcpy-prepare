#!/usr/bin/env bash

# WARN: WIP

# SCREEN_DENSITY=600
# WINDOW_RESOLUTION="2560x1600"
PROGNAME=$(basename $0)

SCREEN_DENSITY=280
WINDOW_RESOLUTION="1920x1080"

# adb shell wm size 1920x1080
# adb shell wm density 280

enable() {
  adb shell wm density $SCREEN_DENSITY
  adb shell wm size $WINDOW_RESOLUTION
  echo "Enabled !"
}

disable() {
  adb shell wm size reset
  adb shell wm density reset
  echo "Disabled !"
}

help() {
  echo "$PROGNAME on"
  echo "$PROGNAME off"
  echo "$PROGNAME help"
}

case "$1" in
  on) enable ;;
  off) disable ;;
  help) help ;;
  *) help ;;
esac
