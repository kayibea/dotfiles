#!/usr/bin/env bash
set -euo pipefail

export EDITOR="${EDITOR:-vi}"
DICO=""

search_paths=(
  "./dictionary.csv"
  "$(dirname "$0")/dictionary.csv"
  "${XDG_DATA_HOME:-$HOME/.local/share}/dictionary.csv"
  "$HOME/.local/share/dictionary.csv"
)

for path in "${search_paths[@]}"; do
  if [[ -f "$path" ]]; then
    DICO="$path"
    break
  fi
done

if [[ -z "$DICO" ]]; then
  printf "Dictionary file not found\n" >&2
  printf "Checked:\n" >&2
  for p in "${search_paths[@]}"; do printf "  %s\n" "$p" >&2; done
  exit 1
fi

preview_line() {
  strip_quotes() {
    local s="$1"
    s="${s#\"}"
    s="${s%\"}"
    printf '%s' "$s"
  }

  IFS=',' read -r word pos def <<<"$1"

  word=$(strip_quotes "$word")
  pos=$(strip_quotes "$pos")
  def=$(strip_quotes "$def")
  def=${def//\"/}

  cat <<EOF
# $word (${pos:--})
**Definition:**
$def
EOF
}

export -f preview_line
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

while true; do
  tmpfile=$(mktemp "$tmpdir/dico-XXXXXX.md")

  awk '
{
    line = $0
    sub(/^"/, "", line)
    sub(/"$/, "", line)
    split(line, fields, "\",\"")
    word = fields[1]
    pos  = fields[2]
    if (pos == "") pos="-"
    printf "%s (%s)\t%s\n", word, pos, $0
}
' "$DICO" | fzf --with-nth=1 \
    --preview 'preview_line "$(echo {} | cut -f2-)" | CLICOLOR_FORCE=1 glow -s dark' \
    --preview-window=right:70% \
    --preview-window=wrap \
    --delimiter=$'\t' | cut -f2- >$tmpfile

  preview_line "$(cat $tmpfile)" >$tmpfile
  chmod 444 $tmpfile
  "$EDITOR" $tmpfile
done
