#!/usr/bin/env bash
set -euo pipefail

LOCAL_FWD_PORT=8022
LOCAL_REV_PORT=2222
REMOTE_REV_PORT=22

usage() {
  echo "usage: ${0##*/} -f [local-port [remote-port]]"
  echo "       ${0##*/} -r [local-port [remote-port]]"
  exit 1
}

is_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && ((1 <= 10#$1 && 10#$1 <= 65535))
}

(($#)) || usage
mode="$1"
shift

case "$mode" in
  -f)
    lp="${1:-$LOCAL_FWD_PORT}"
    rp="${2:-$lp}"
    ;;
  -r)
    lp="${1:-$LOCAL_REV_PORT}"
    rp="${2:-$REMOTE_REV_PORT}"
    ;;
  *)
    usage
    ;;
esac

is_port "$lp" && is_port "$rp" || {
  echo "invalid port: $lp $rp" >&2
  exit 1
}

case "$mode" in
  -f) adb forward "tcp:$lp" "tcp:$rp" ;;
  -r) adb reverse "tcp:$lp" "tcp:$rp" ;;
esac
