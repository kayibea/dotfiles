#!/usr/bin/env bash
set -euo pipefail

# lc: Long Command. Type a long shell command into the editor

EDITOR="${EDITOR:-vi}"

tmpfile="$(mktemp --suffix .sh)"

trap 'rm -f "$tmpfile"' EXIT

"$EDITOR" "$tmpfile"

if (($(grep -cve '^\s*$' "$tmpfile") < 1)); then
  exit 1
fi

text="$(sed '/^$/d' "$tmpfile")"
(
  sleep 0.1
  xdotool type -- "$text"
) &
