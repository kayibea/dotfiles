#!/usr/bin/env bash
set -eo pipefail

EXTRA_ARGS=""

while getopts ":f" opt; do
  case "$opt" in
    f) EXTRA_ARGS="$EXTRA_ARGS -no-snapshot-load" ;;
    \?)
      echo "invalid option: -$OPTARG"
      exit 1
      ;;
  esac
done

avd_list=$(emulator -list-avds)

if [ -z "$avd_list" ]; then
  rofi -e "No Android Virtual Devices found."
  exit 1
fi

avd=$(echo "$avd_list" | rofi -dmenu -i -p "Select AVD:" -theme-str 'window {width: 25%;}')

if [ -z "$avd" ]; then
  rofi -e "No AVD selected."
  exit 1
fi

echo "Selected AVD: $avd"

emulator -avd "$avd" \
  $EXTRA_ARGS >/dev/null 2>&1 &
