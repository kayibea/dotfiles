#!/usr/bin/env bash
set -euo pipefail

DEFAULT_ARGS=(-no-metrics)

avd_list=$(emulator -list-avds)

if [[ -z "$avd_list" ]]; then
  echo "No Android Virtual Devices found." >&2
  exit 1
fi

avd=$(echo "$avd_list" | rofi -dmenu -i -p "Select AVD:" -theme-str 'window {width: 25%;}') || true

if [[ -z "$avd" ]]; then
  echo "No AVD selected." >&2
  exit 1
fi

echo "Selected AVD: $avd"

emulator -avd "$avd" "${DEFAULT_ARGS[@]}" "$@"
