#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage:"
  echo "    ${0##*/} <file>"
  exit 1
fi

FILE="$1"

if [[ ! -f "$FILE" ]]; then
  echo "File '$FILE' does not exist or is not a regular file" >&2
  exit 1
fi

case "$FILE" in
  *.tar* | *.tgz | *.tbz2 | *.txz) tar xf "$FILE" ;;
  *.zip) unzip "$FILE" ;;
  *.7z) 7z x "$FILE" ;;
  *.rar) unrar x "$FILE" ;;
  *.gz) gunzip "$FILE" ;;
  *.bz2) bunzip2 "$FILE" ;;
  *.xz) xz -d "$FILE" ;;
  *.pax) pax -r <"$FILE" ;;
  *.pax.Z) uncompress --stdout "$FILE" | pax -r ;;
  *.Z) uncompress "$FILE" ;;
  *)
    echo "File '$FILE' cannot be extracted via $PROGNAME" >&2
    ;;
esac
