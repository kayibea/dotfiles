#!/usr/bin/env bash
set -eo pipefail

# Open an executable from $PATH into the default editor

EDITOR="${EDITOR:-${VISUAL:-vi}}"

usage() {
  echo "Usage: $(basename "$0") [cmd1 cmd2 cmd3...]"
}

if (($# < 1)); then
  usage
  exit 1
fi

file_paths=()
for cmd in "$@"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Command '$cmd' not in \$PATH" >&2
    exit 1
  fi

  fpath=$(realpath -q "$(command -v "$cmd")")

  if ! file --mime-type -b "$fpath" | grep -q '^text/'; then
    echo "Invalid mime type: $fpath" >&2
    exit 1
  fi

  file_paths+=("$fpath")
done

"$EDITOR" "${file_paths[@]}"
