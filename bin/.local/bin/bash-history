#!/usr/bin/env bash
set -euo pipefail

copy_only=false
if [[ "${1:-}" == "-c" ]]; then
  copy_only=true
fi

history_file="${HISTFILE:-$HOME/.bash_history}"

entry="$(
  tac "$history_file" |
    awk '!seen[$0]++' |
    tac |
    fzf
)"

[[ -z "$entry" ]] && exit 0

if $copy_only; then
  printf '%s' "$entry" | xclip -selection clipboard
else
  (
    sleep .1
    xdotool type --delay 0 "$entry"
  ) >/dev/null 2>&1 &
fi
