#!/usr/bin/env bash
set -euo pipefail

BANG='#!/usr/bin/env bash'
EDITOR="${EDITOR:-vi}"

if (($# < 1)); then
  echo "Usage $(basename "$0") file" >&2
  exit 1
fi

FILE="$(slugify "$1")"

if [[ -e "$FILE" ]]; then
  echo "$FILE already exists" >&2
  exit 1
fi

echo "$BANG" >"$FILE"
chmod u+x "$FILE"

"$EDITOR" "$FILE"
