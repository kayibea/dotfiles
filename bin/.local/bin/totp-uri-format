#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} SECRET -i ISSUER [options]

Required:
  SECRET                    Base32 secret
  -i, --issuer ISSUER        Issuer name

Optional:
  -a, --account ACCOUNT      Account name (label)
  -A, --algorithm ALGO       SHA1 | SHA256 | SHA512
  -d, --digits DIGITS        6 or 8
  -p, --period SECONDS
  -h, --help                 Show help

Example:
  ${0##*/} JBSWY3DPEHPK3PXP -i GitHub -a user@example.com
EOF
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

secret="$1"
shift

issuer=""
account=""
algorithm=""
digits=""
period=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -i | --issuer)
      issuer="$2"
      shift 2
      ;;
    -a | --account)
      account="$2"
      shift 2
      ;;
    -A | --algorithm)
      algorithm="$2"
      shift 2
      ;;
    -d | --digits)
      digits="$2"
      shift 2
      ;;
    -p | --period)
      period="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ -z "$issuer" ]]; then
  echo "Error: issuer is required" >&2
  usage
  exit 1
fi

label="$issuer"
if [[ -n "$account" ]]; then
  label="${issuer}:${account}"
fi

secret="$(printf '%s' "$secret" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')"
uri="otpauth://totp/${label}?secret=${secret}&issuer=${issuer}"

[[ -n "$algorithm" ]] && uri+="&algorithm=${algorithm}"
[[ -n "$digits" ]] && uri+="&digits=${digits}"
[[ -n "$period" ]] && uri+="&period=${period}"

printf '%s\n' "$uri"
