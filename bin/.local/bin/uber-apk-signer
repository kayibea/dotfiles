#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
JAR_FILE="$SCRIPT_DIR/uber-apk-signer.jar"

if ! command -v java &>/dev/null; then
  echo "Java is not installed" >&2
  exit 1
fi

if [[ ! -f "$JAR_FILE" ]]; then
  echo "JAR File not found at: $JAR_FILE" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  java -jar "$JAR_FILE" --help
  exit 1
fi

java -jar "$JAR_FILE" "$@"
