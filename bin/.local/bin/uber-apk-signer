#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
UBER_SIGNER_JAR="$SCRIPT_DIR/uber-apk-signer.jar"
# SCRIPT_NAME="$(basename "$0")"

if ! command -v java >/dev/null 2>&1; then
  echo "Error: Java is not installed. Please install Java to use this script." >&2
  exit 1
fi

if [[ ! -f "$UBER_SIGNER_JAR" ]]; then
  echo "Error: Uber APK Signer JAR not found at: $UBER_SIGNER_JAR" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  java -jar "$UBER_SIGNER_JAR" --help
  exit 1
fi

java -jar "$UBER_SIGNER_JAR" "$@"
