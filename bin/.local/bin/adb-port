#!/usr/bin/env bash
set -eo pipefail

LOCAL_FWD_PORT=8022 # host -> phone
LOCAL_REV_PORT=2222 # phone -> host
REMOTE_REV_PORT=22

usage() {
  echo "usage: $(basename $0) [-f|-r] [local-port remote-port]"
  exit 1
}

mode="$1"
shift || true

case "$mode" in
  -f)
    lp="${1:-$LOCAL_FWD_PORT}"
    rp="${2:-$lp}"
    adb forward "tcp:$lp" "tcp:$rp"
    ;;
  -r)
    lp="${1:-$LOCAL_REV_PORT}"
    rp="${2:-$REMOTE_REV_PORT}"
    adb reverse "tcp:$lp" "tcp:$rp"
    ;;
  *)
    usage
    ;;
esac
