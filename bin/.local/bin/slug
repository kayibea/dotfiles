#!/usr/bin/env bash
set -euo pipefail

slugify() {
  local input="${1:-}"
  [[ -z "$input" ]] && {
    echo ""
    return
  }

  echo "$input" |
    iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g' |
    sed -E 's/^-+|-+$//g'
}

if [[ $# -gt 0 ]]; then
  for arg in "$@"; do
    slugify "$arg"
  done
  exit 0
fi

command -v inotifywait >/dev/null 2>&1 || {
  echo "error: inotifywait not found (install inotify-tools)" >&2
  exit 1
}

tmpfile="$(mktemp /tmp/slug.XXXXXX)"
tmpdir="$(dirname "$tmpfile")"
tmpbase="$(basename "$tmpfile")"

watcher() {
  # watch the directory, filter events
  while inotifywait -q -e close_write -e moved_to "$tmpdir" >/dev/null 2>&1; do
    # check if the edited file is what changed
    if [[ -f "$tmpfile" ]]; then
      IFS= readarray -t lines <"$tmpfile"
      {
        for line in "${lines[@]}"; do
          slugify "$line"
        done
      } >"${tmpfile}.tmp"

      mv "${tmpfile}.tmp" "$tmpfile"
    fi
  done
}

watcher &
watcher_pid=$!

cleanup() {
  kill "$watcher_pid" 2>/dev/null || true
  rm -f "$tmpfile"
}
trap cleanup EXIT INT TERM

"${EDITOR:-vi}" "$tmpfile"

wait "$watcher_pid"
