#!/usr/bin/env bash
set -euo pipefail

OUTPUT="DP-2"
MODE="1920x1080"

current=$(powerprofilesctl get)

choice=$(
  printf "performance\nbalanced\npower-saver\n" |
    sed "s/^$current/& */" |
    fzf --prompt="Power Profile > " --height=10 --border
) || exit 0

choice=${choice% *}

powerprofilesctl set "$choice"

case "$choice" in
  performance | balanced)
    xrandr --output "$OUTPUT" --mode "$MODE" --rate 144
    ;;
  power-saver)
    xrandr --output "$OUTPUT" --mode "$MODE" --rate 60
    ;;
esac

notify-send "Power profile" "$choice"
