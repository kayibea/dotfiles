#!/usr/bin/env bash
set -euo pipefail

DIGITS=6
PERIOD=30
ALGO="sha1"
CLIP=false
PRETTY=false

log_err() {
  echo "$*" >&2
}

usage() {
  cat <<EOF
Usage: echo "BASE32_SECRET" | ${0##*/} [options]

Options:
  -d, --digits NUM    Length of code (default: $DIGITS)
  -p, --period SEC    Time step in seconds (default: $PERIOD)
  -a, --algo TYPE     sha1, sha256, or sha512 (default: $ALGO)
  -c, --clip          Copy code to clipboard
      --pretty        Format output (e.g. 123-456)
  -h, --help          Show this help
EOF
}

check_deps() {
  local deps=(openssl xxd base32)
  local missing=()
  for cmd in "${deps[@]}"; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    log_err "Missing dependencies: ${missing[*]}"
    exit 1
  fi
}

base32_to_hex() {
  local secret="$1"
  local clean_secret="${secret//[[:space:]]/}"

  if ! echo "$clean_secret" | base32 --decode 2>/dev/null | xxd -p -c 256 | tr -d '\n'; then
    log_err "Invalid Base32 secret. Please check input or padding."
    exit 1
  fi
}

copy_to_clipboard() {
  local input=$1
  local -a cmd=()

  if command -v wl-copy &>/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    cmd=(wl-copy)
  elif [[ -n ${DISPLAY:-} ]]; then
    if command -v xclip &>/dev/null; then
      cmd=(xclip -selection clipboard)
    elif command -v xsel &>/dev/null; then
      cmd=(xsel --clipboard --input)
    fi
  elif command -v pbcopy &>/dev/null; then
    cmd=(pbcopy)
  elif command -v clip.exe &>/dev/null; then
    cmd=(clip.exe)
  fi

  [[ ${#cmd[@]} -gt 0 ]] && printf '%s' "$input" | "${cmd[@]}"
}

generate_hotp() {
  local key_hex="$1"
  local time_step="$2"
  local algorithm="$3"

  local counter_hex
  counter_hex=$(printf '%016x' "$time_step")

  local hmac_hex
  hmac_hex=$(printf "%s" "$counter_hex" | xxd -r -p |
    openssl dgst "-$algorithm" -mac HMAC -macopt hexkey:"$key_hex" -binary |
    xxd -p -c 256)

  local offset=$((0x${hmac_hex: -1} & 0xf))
  local start=$((offset * 2))
  local segment=${hmac_hex:$start:8}
  local binary=$((0x$segment & 0x7fffffff))

  echo "$binary"
}

format_output() {
  local code="$1"
  if [[ "$PRETTY" = true ]]; then
    local mid=$((${#code} / 2))
    echo "${code:0:$mid}-${code:$mid}"
  else
    echo "$code"
  fi
}

main() {
  check_deps

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d | --digits)
        DIGITS="$2"
        shift 2
        ;;
      -p | --period)
        PERIOD="$2"
        shift 2
        ;;
      -a | --algo)
        ALGO="$2"
        shift 2
        ;;
      -c | --clip)
        CLIP=true
        shift 1
        ;;
      --pretty)
        PRETTY=true
        shift 1
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        log_err "Unknown option: $1"
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ ! "$ALGO" =~ ^(sha1|sha256|sha512)$ ]]; then
    log_err "Invalid algo '$ALGO'."
    exit 1
  fi

  if [[ -t 0 ]]; then
    log_err "No secret provided on stdin."
    exit 1
  fi

  local secret_raw
  secret_raw=$(cat)
  [[ -z "$secret_raw" ]] && {
    log_err "No secret provided"
    exit 1
  }

  local key_hex
  key_hex=$(base32_to_hex "$secret_raw")
  local totp_mod=$((10 ** DIGITS))

  local last_step=-1
  local display_code=""

  command -v tput &>/dev/null && tput civis
  trap 'command -v tput &>/dev/null && tput cnorm; exit 0' SIGINT SIGTERM

  while true; do
    local now
    printf -v now '%(%s)T' -1

    local step=$((now / PERIOD))
    local remaining=$((PERIOD - (now % PERIOD)))

    if [[ "$step" != "$last_step" ]]; then
      local binary_code
      binary_code=$(generate_hotp "$key_hex" "$step" "$ALGO")
      local otp=$((binary_code % totp_mod))
      local padded_otp
      padded_otp=$(printf "%0*d" "$DIGITS" "$otp")

      [[ "$CLIP" = true ]] && copy_to_clipboard "$padded_otp"
      display_code=$(format_output "$padded_otp")
      last_step=$step
    fi

    printf "\rExpires in: %2ds | Code: %s" "$remaining" "$display_code"
    sleep 1
  done
}

main "$@"
