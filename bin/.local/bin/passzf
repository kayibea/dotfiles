#!/usr/bin/env bash

set -euo pipefail

STORE="${HOME}/.password-store"
[ -d "${HOME}/.pasword-store" ] && STORE="${HOME}/.pasword-store"

entries=$(find "$STORE" -type f -name '*.gpg' |
  sed "s|^$STORE/||" |
  sed 's/\.gpg$//')

choice=$(printf '%s\n' "$entries" | fzf --layout=reverse --prompt="pass> ") || exit 0
[ -z "$choice" ] && exit 0

pass edit "$choice"
