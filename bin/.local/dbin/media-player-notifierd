#!/usr/bin/env bash
set -euo pipefail
set -m

DEBOUNCE_DELAY=1
TRACK_INFO_FMT='{{ artist }} - {{ title }}|{{ mpris:artUrl }}'

PLAYERS=(
  # vlc
  brave
)

declare -A PLAYER_ICONS=(
  [vlc]="vlc"
  [brave]="brave"
)

declare -A NOTIFY_IDS=(
  [vlc]=$((16#0df38f21))
  [brave]=$((16#0df38f20))
)

get_icon() {
  local player="$1" art="$2"

  if [[ "$art" == file://* && -f "${art#file://}" ]]; then
    echo "${art#file://}"
  else
    echo "${PLAYER_ICONS[$player]:-media-playback-start}"
  fi
}

send_notify() {
  local id="$1" title="$2" icon="$3"
  notify-send "Now Playing" "$title" -r "$id" -i "$icon"
}

watch_player() {
  local player="$1"
  local notify_id="${NOTIFY_IDS[$player]}"
  local debounce_pid=0

  while IFS='|' read -r track art; do
    [[ -z "$track" ]] && continue

    local icon
    icon="$(get_icon "$player" "$art")"

    if ((debounce_pid)); then
      kill "$debounce_pid" 2>/dev/null || true
    fi

    (
      sleep "$DEBOUNCE_DELAY"
      send_notify "$notify_id" "$track" "$icon"
    ) &
    debounce_pid=$!

  done < <(
    exec playerctl metadata -p "$player" --follow --format "$TRACK_INFO_FMT"
  )
}

cleanup() {
  kill -- -$$ 2>/dev/null || true
}

trap cleanup SIGINT SIGTERM EXIT

for player in "${PLAYERS[@]}"; do
  watch_player "$player" &
done

wait
