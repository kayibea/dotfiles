[Unit]
Description=YouTube Music MPRIS track notification daemon
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/sysd/ytm-notify
Restart=on-failure
RestartSec=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=default.target
