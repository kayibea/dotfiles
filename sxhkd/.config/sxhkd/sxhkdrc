# Fullscreen screenshot
Print
    scrot ~/Pictures/%Y-%m-%d-%H%M%S.png

# Select area and save
ctrl + Print
    scrot -s ~/Pictures/%Y-%m-%d-%H%M%S.png

# Select area and copy to clipboard
shift + Print
    scrot -s /tmp/screenshot.png && xclip -selection clipboard -t image/png -i /tmp/screenshot.png && notify-send "Screenshot copied to clipboard"

XF86AudioRaiseVolume
    pactl set-sink-volume @DEFAULT_SINK@ +5%

XF86AudioLowerVolume
    pactl set-sink-volume @DEFAULT_SINK@ -5%

XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle

XF86AudioPlay
    playerctl play-pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous
