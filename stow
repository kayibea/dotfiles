#!/usr/bin/env bash
set -euo pipefail

STOW_FLAGS=("--verbose" "-t" "$HOME")

usage() {
  cat <<EOF
Usage: ${0##*/} [OPTIONS]

Options:
  -r, --remove    Unlink stowed configs
  -h, --help      Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -r | --remove)
      shift
      STOW_FLAGS+=("-D")
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

echo "--- Previewing changes ---"

stow "${STOW_FLAGS[@]}" -n */

echo

read -n 1 -p "Do you want to proceed with these changes? (y/n) " yn
echo

case "$yn" in
  [Yy]*)
    echo "Applying changes..."
    stow "${STOW_FLAGS[@]}" */
    echo "All done!"
    ;;
  *)
    echo "Aborted! No changes were made."
    exit 0
    ;;
esac
