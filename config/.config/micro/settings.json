{
  "statusformatl": " $(status.icon) $(filename) $(modified)$(overwrite) ",
  "statusformatr": " Ln $(line):$(col) | $(opt:filetype) | $(opt:encoding)   $(status.branch) ",
  "softwrap": false,
  "reload": "auto",
  "autosu": false,
  "detectlimit": 300,
  "basename": true,
  "rmtrailingws": true,
  "parsecursor": true,
  "matchbracestyle": "underline",
  "hltrailingws": true,
  "hltaberrors": true,
  "fastdirty": false,
  "hlsearch": true,
  "divchars": "┃━",
  "divreverse": false,
  "clipboard": "external",
  "colorscheme": "one-dark",
  "lsp.autocompleteDetails": true,
  "lsp.ignoreTriggerCharacters": "completion,signature",
  "lsp.server": "lua=lua-language-server,typescript=typescript-language-server --stdio",
  "lsp.tabcompletion": true,
  "tabsize": 2,
  "tabstospaces": true,
  "ft:go": {
    "tabstospaces": false,
    "rmtrailingws": false,
    "lsp.autocompleteDetails": false,
    "lsp.tabcompletion": false,
    "lsp.formatOnSave": false
  }
}
